@page
@model Rinoleggio.Web.Pages.Contracts.CreateModel
@{ ViewBag.Title = "Nuovo contratto"; }
<div class="container py-3">
    <h1 class="h3 mb-3">Nuovo contratto</h1>
    <form method="post" class="card"><div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <partial name="_ContractForm" model="(Model.Contract, Model.Lookups)" />
        <div class="mt-3 d-flex flex-wrap gap-2">
            <button type="submit" asp-page-handler="SaveDraft" class="btn btn-outline-primary">Salva bozza</button>
            <button type="submit" asp-page-handler="Publish" class="btn btn-primary">Pubblica</button>
            <a asp-page="/Contracts/Index" class="btn btn-link">Annulla</a>
        </div>
    </div></form>
</div>
