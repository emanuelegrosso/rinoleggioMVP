@page
@using Rinoleggio.Web.Pages.Leads
@model Rinoleggio.Web.Pages.Leads.IndexModel
@{ ViewBag.Title = "Lead backoffice"; }
<div class="container py-3">
    <h1 class="h3 mb-3">Richieste (backoffice)</h1>
    @if (Model.Results.TotalCount == 0)
    {
        <div class="alert alert-light border">Nessuna richiesta.</div>
    }
    else
    {
        <table class="table table-striped align-middle small">
            <thead>
            <tr>
                <th>Annuncio</th>
                <th>Acquirente</th>
                <th>Venditore</th>
                <th>Messaggio</th>
                <th>Stato</th>
                <th>Telefono</th>
                @if (Model.CanManageLeads){<th>Gestione</th>}
            </tr>
            </thead>
            <tbody>
            @foreach (var lead in Model.Results.Items)
            {
                <tr>
                    <td><a asp-page="/Contracts/Detail" asp-route-id="@lead.ListingId">@(lead.ListingTitle ?? "Annuncio")</a></td>
                    <td>
                        @(lead.BuyerVisibleName ?? lead.BuyerUserName)
                        @if (!string.IsNullOrEmpty(lead.BuyerEmail))
                        {
                            <div class="text-muted">@lead.BuyerEmail</div>
                        }
                    </td>
                    <td>
                        @lead.SellerVisibleName
                        @if (!string.IsNullOrEmpty(lead.SellerEmail))
                        {
                            <div class="text-muted">@lead.SellerEmail</div>
                        }
                    </td>
                    <td>@lead.Message</td>
                    <td>@LeadFormHelper.GetStatusLabel(lead.Status)</td>
                    <td>@lead.Phone</td>
                    @if (Model.CanManageLeads)
                    {
                        <td>
                            <form method="post" asp-page-handler="UpdateStatus" class="row g-1">
                                <input type="hidden" name="leadId" value="@lead.Id" />
                                <div class="col-auto">
                                    <select name="status" class="form-select form-select-sm">
                                        @foreach (var s in LeadFormHelper.Statuses)
                                        {
                                            if (lead.Status == s.Value)
                                            {
                                                <option value="@((int)s.Value)" selected="selected">@s.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@((int)s.Value)">@s.Label</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-auto"><input name="backofficeNotes" class="form-control form-control-sm" placeholder="Note interne" value="@lead.BackofficeNotes" /></div>
                                <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Aggiorna</button></div>
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    }
</div>
