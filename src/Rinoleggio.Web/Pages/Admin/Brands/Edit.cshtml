@page "{id:guid}"
@model Rinoleggio.Web.Pages.Admin.Brands.EditModel
@{ ViewBag.Title = "Modifica marca"; }
<div class="container py-3">
    <h1 class="h3 mb-3">Modifica marca</h1>
    <form method="post" class="card"><div class="card-body row g-3">
        <div class="col-md-6"><label class="form-label">Nome</label><input asp-for="Brand.Name" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Ordine</label><input asp-for="Brand.SortOrder" class="form-control" type="number" /></div>
        <div class="col-md-3 form-check mt-4"><input asp-for="Brand.IsActive" class="form-check-input" /><label class="form-check-label" asp-for="Brand.IsActive">Attiva</label></div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salva</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Annulla</a>
        </div>
    </div></form>
</div>
