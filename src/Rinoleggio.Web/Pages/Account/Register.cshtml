@page
@model Rinoleggio.Web.Pages.Account.RegisterModel
@{ ViewBag.Title = "Registrazione"; Layout = null; }
<!DOCTYPE html>
<html lang="it">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Registrazione Rinoleggio</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /></head>
<body class="bg-light">
<div class="container py-5"><div class="row justify-content-center"><div class="col-md-6">
    <div class="card shadow-sm"><div class="card-body">
        <h1 class="h4 mb-3">Registrazione</h1>
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-2"><label class="form-label">Nome utente</label><input asp-for="Input.UserName" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Email</label><input asp-for="Input.EmailAddress" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Password</label><input asp-for="Input.Password" class="form-control" type="password" /></div>
            <div class="mb-2"><label class="form-label">Nome completo</label><input asp-for="Input.FullName" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Tipo account</label>
                <select asp-for="Input.AccountRole" class="form-select">
                    <option value="@Rinoleggio.RinoleggioRoles.Customer">Privato (Customer)</option>
                    <option value="@Rinoleggio.RinoleggioRoles.Dealer">Dealer</option>
                </select>
            </div>
            <div class="form-check mb-3"><input class="form-check-input" asp-for="Input.PrivacyConsent" /><label class="form-check-label" asp-for="Input.PrivacyConsent">Acconsento al trattamento dei dati personali</label></div>
            <button type="submit" class="btn btn-primary w-100">Registrati</button>
        </form>
        <p class="mt-3 mb-0"><a href="~/Account/Login">Hai già un account? Accedi</a></p>
    </div></div>
</div></div></div>
</body></html>
